<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup / device transfer coverage (Android 12+).
  allowBackup=true with no rules would back up everything in internal storage;
  these rules preserve that coverage except for the offline map regions, which
  are 150-400 MB user-supplied PMTiles files that must not go to the cloud.
  The Room database and the DataStore preferences keep backing up as before.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="." />
        <exclude domain="file" path="maps/" />
        <include domain="database" />
        <include domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <exclude domain="file" path="maps/" />
        <include domain="database" />
        <include domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
