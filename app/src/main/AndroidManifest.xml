<?xml version="1.0" encoding="utf-8"?>
<!--
  Permission set locked per DOCUMENTATION.md §Permissions and AGENTS.md.
  Deliberately absent and to stay absent: INTERNET (the app's central privacy
  property), ACCESS_BACKGROUND_LOCATION, WAKE_LOCK, ACTIVITY_RECOGNITION.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- MapLibre's AAR manifest declares INTERNET / ACCESS_NETWORK_STATE /
         ACCESS_WIFI_STATE / ACCESS_COARSE_LOCATION. The app is fully offline:
         the basemap's only source is a user-supplied LOCAL PMTiles file loaded
         via pmtiles://file:// — never remote tiles, never a remote style — so
         INTERNET / WIFI_STATE / COARSE_LOCATION are stripped here at merge
         time. ACCESS_NETWORK_STATE is kept: MapLibre's ConnectivityReceiver
         calls ConnectivityManager from its CONNECTIVITY_CHANGE handler and
         crashes with SecurityException without it (DOCUMENTATION.md
         §Permissions). It grants no network access — the app still holds no
         INTERNET permission. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- DOCUMENTATION.md "Known device problems", mitigation 1: requested during onboarding. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".Dok2Application"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Dok2">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Source of truth for recording state; must work with no UI process alive. -->
        <service
            android:name=".recording.RecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Restarts recording into the open track after a reboot (mitigation 5). -->
        <receiver
            android:name=".recording.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
